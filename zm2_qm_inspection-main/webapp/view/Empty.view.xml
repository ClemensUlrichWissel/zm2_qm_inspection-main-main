<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="de.mindsquare.InspectionQM.controller.Empty"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page title="{i18n>titleDetailPage}">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://menu2" text="{i18n>titleMasterPage}" type="Transparent" press="onShowMaster"/>
					<Title text="{i18n>titleDetailPage}" level="H2"/>
				</contentLeft>
			</Bar>
		</customHeader>
		<content>
			<MessagePage showHeader="false" icon="sap-icon://filter"
				description="{i18n>descriptionEmpty}" text="{i18n>textEmpty}"/>
		</content>
	</Page>
</mvc:View>
