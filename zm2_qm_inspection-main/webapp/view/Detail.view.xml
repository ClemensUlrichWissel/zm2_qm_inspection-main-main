<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="de.mindsquare.InspectionQM.controller.Detail"
	xmlns:html="http://www.w3.org/1999/xhtml" xmlns:upload="sap.m.upload">
	<Page title="{i18n>titleDetailPage}">
		<content>
			<HBox alignItems="Start" justifyContent="SpaceBetween" width="100%" wrap="Wrap">
				<ObjectHeader
					intro="{i18n>InspectionLot}"
					title="{InspectionLotNumber}">
					<attributes>
						<ObjectAttribute title="{i18n>order}" text="{OrderNumber}"/>
						<ObjectAttribute title="{i18n>createdBy}" text="{CreatedBy}"/>
						<ObjectAttribute title="{i18n>material}" text="{Material}"/>
						<ObjectAttribute title="{i18n>materialText}" text="{MaterialText}"/>
						<ObjectAttribute title="{i18n>workcenter}" text="{Workcenter}"/>
						<ObjectAttribute title="{i18n>batch}" text="{Batch}" visible="{=${Batch} !== ''}"/>
					</attributes>
				</ObjectHeader>
				<VBox class="sapUiMediumMargin" justifyContent="Center" alignItems="End">
					<Label text="{i18n>inspectionType}" required="true" labelFor="idInspectionType" class="sapUiTinyMarginBottom"/>
					<Select id="idInspectionType"
						selectedKey="{Usern2}"
						forceSelection="false"
						width="220px"
						items="{path: '/InspectionTypeSet', templateShareable: false}">
						<core:Item key="{Code}" text="{Description}"/>
					</Select>
				</VBox>
			</HBox>
			<IconTabBar select="onTabSelect" class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter key="open" icon="sap-icon://pending" design="Horizontal">
						<List id="idOpenActionsList" items="{path: 'toActions', filters: [{path: 'Closed', operator: 'EQ', value1: false}]}">
							<core:Fragment fragmentName="de.mindsquare.InspectionQM.view.fragments.ActionListItem" type="XML"/>
						</List>
					</IconTabFilter>
					<IconTabFilter key="operations" icon="sap-icon://activities" design="Horizontal">
						<Toolbar>
							<ToolbarSpacer/>
							<Button icon="sap-icon://expand-group" text="{i18n>expandAll}" press="onExpandAllOperations"/>
							<Button icon="sap-icon://collapse-group" text="{i18n>collapseAll}" press="onCollapseAllOperations"/>
						</Toolbar>
						<List id="idOperationsList" items="{toActions}">
							<core:Fragment fragmentName="de.mindsquare.InspectionQM.view.fragments.ActionListItemReadOnly" type="XML"/>
						</List>
					</IconTabFilter>
					<IconTabFilter key="all" icon="sap-icon://clinical-tast-tracker" design="Horizontal">
						<Toolbar>
							<ToolbarSpacer/>
							<Button icon="sap-icon://expand-group" text="{i18n>expandAll}" press="onExpandAllHistory"/>
							<Button icon="sap-icon://collapse-group" text="{i18n>collapseAll}" press="onCollapseAllHistory"/>
						</Toolbar>
						<List id="idMainList" updateFinished="onHistoryListUpdateFinished" items="{
								path: 'toActions',
								filters: [{path: 'Closed', operator: 'EQ', value1: true}],
								sorter: [
									{path: 'Userd1', descending: true},
									{path: 'Usert1', descending: true}
								]
							}">
							<core:Fragment fragmentName="de.mindsquare.InspectionQM.view.fragments.ActionListItem" type="XML"/>
						</List>
					</IconTabFilter>
					<IconTabFilter icon="sap-icon://attachment" design="Horizontal">
						<upload:UploadSet
							instantUpload="true"
							showIcons="false"
							uploadEnabled="true"
							terminationEnabled="false"
							uploadUrl="/sap/opu/odata/sap/ZM2_QM_INSPECTION_SRV/InspectionLotAttachmentSet"
							items="{path: 'toAttachments', templateShareable: false}"
							beforeUploadStarts="onBeforeUploadStarts"
							uploadCompleted="onUploadCompleted"
							afterItemRemoved="onAfterItemRemoved"
							openPressed="onOpenAttachment">
							<upload:items>
								<upload:UploadSetItem
									fileName="{Filename}"
									mediaType="{Mimetype}"
									visibleEdit="false"
									url="/sap/opu/odata/sap/ZM2_QM_INSPECTION_SRV/InspectionLotAttachmentSet(InspectionLot='{InspectionLot}',AttachmentId='{AttachmentId}')/$value"/>
							</upload:items>
						</upload:UploadSet>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<footer>
			<Bar>
				<contentMiddle>
					<!--<Button press="onAddNewSample" icon="sap-icon://add" text="{i18n>createNewSample}"
						visible="{= ${AllowsNewSample} &amp;&amp; !${HasUsageDecision}}"/>-->
					<Button press="onAddNewInspPoint" icon="sap-icon://add" text="{i18n>createNewInspPoint}"
						visible="{= ${AllowsNewSample} &amp;&amp; !${HasUsageDecision}}"/>
				</contentMiddle>
				<!-- <contentRight>
					<Button press="onUsageDecision" type="Accept" icon="sap-icon://validate" text="{i18n>usageDecision}"
						visible="{= !${HasUsageDecision}}"/>
				</contentRight> -->
			</Bar>
		</footer>
	</Page>
</mvc:View>