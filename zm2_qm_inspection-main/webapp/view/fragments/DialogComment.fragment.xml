<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>enter-comment}">
		<content>
			<TextArea width="100%"/>
		</content>
		<buttons>
			<Button type="Accept" text="{i18n>accept}" press="onAcceptComment" />
			<Button type="Reject" text="{i18n>cancel}" press="onCancelComment" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>