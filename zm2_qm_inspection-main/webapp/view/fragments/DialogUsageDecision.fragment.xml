<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>usageDecision}">
		<content>
			<VBox class="sapUiTinyMarginBeginEnd">
				<Select items="{toUsageDecisions}" forceSelection="false" selectedKey="{DecisionModel>/Decision}" showSecondaryValues="true" width="100%">
					<core:ListItem text="{Description}" key="{DecisionKey}" additionalText="{DecisionKey}"/>
				</Select>
				
				<Label text="{i18n>decision-comment}" />
				<TextArea width="100%" value="{DecisionModel>/Comment}"/>
				
				<Label text="{i18n>storage-location}" visible="{DecisionModel>/IsStockRelevant}" />
				<Input selectedKey="{DecisionModel>/DefaultStorageLoc}" visible="{DecisionModel>/IsStockRelevant}" 
					showSuggestion="true" suggestionItems="{path: '/StorageLocationSet', length: 300}">
					<suggestionItems>
						<core:ListItem text="{StorageLocationName}" key="{StorageLocationId}" additionalText="{StorageLocationId}" />
					</suggestionItems>
				</Input>
			</VBox>
			
		</content>
		<buttons>
			<Button type="Accept" press="onAcceptDecision" text="{i18n>ok}" />
			<Button type="Reject" press="onRejectDecision" text="{i18n>cancel}" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>