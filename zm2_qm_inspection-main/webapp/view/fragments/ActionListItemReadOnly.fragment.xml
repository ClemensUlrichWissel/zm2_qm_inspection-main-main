<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<CustomListItem>
		<Panel expandable="true" expanded="false" class="sapUiSmallMargin">
			<headerToolbar>
				<Toolbar>
					<Title level="H1"
						text="{parts: [
							{path: 'InspLotAction'},
							{path: 'ActionText'},
							{path: 'Workcenter'},
							{path: 'WorkcenterText'},
							{path: 'ControlKey'}
						], formatter: '.formatOperationOverviewTitle'}"/>
				</Toolbar>
			</headerToolbar>
			<List items="{path: 'toCharacteristics', templateShareable: false}"
				updateFinished="onCharacteristicsUpdateFinished">
				<CustomListItem class="sapUiTinyMargin" type="Inactive">
					<!-- Feste Zwei-Spalten-Zeile: links der Text, rechts die Bedienelemente -->
					<HBox alignItems="Start">
						<!-- Textspalte: wächst mit, kann aber schrumpfen (minWidth 0) -> der
						     (Lang-)Text wird darin abgeschnitten, statt die Spalte aufzublähen -->
						<VBox>
							<layoutData>
								<FlexItemData growFactor="3" shrinkFactor="1" minWidth="0"
									styleClass="sapUiSmallMarginBegin"/>
							</layoutData>
							<Text width="100%" text="{parts: [
								{path: 'InspCharacteristic'},
								{path: 'MasterCharact'},
								{path: 'CharactText'},
								{path: 'TargetVal'},
								{path: 'UpTolLmt'},
								{path: 'LwTolLmt'},
								{path: 'CharType'},
								{path: 'UnitText'},
								{path: 'Scope'}
							], formatter: '.formatCharacteristicTitle'}"/>
							<Text width="100%" maxLines="1"
								text="{path: 'CharactLongtext', formatter: '.formatLongtext'}"
								visible="{= !!${CharactLongtext} }"/>
							<Link text="{i18n>showMore}" press="onToggleLongtext" visible="false"/>
						</VBox>
						<!-- Bedienelemente: shrinkFactor 0 -> nie zusammengedrückt -->
						<HBox justifyContent="End" alignItems="Center" wrap="Wrap">
							<layoutData>
								<FlexItemData growFactor="1" shrinkFactor="0" minWidth="14rem"/>
							</layoutData>
							<!-- Übersicht: leere, deaktivierte Felder - nur Typ-Anzeige, keine erfassten Werte -->

							<!-- Qualitativ Scope=1: Ja/Nein -->
							<CheckBox selected="false" enabled="false"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								text="{i18n>yes}"/>
							<CheckBox selected="false" enabled="false"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								text="{i18n>no}"/>

							<!-- Aggregat-Inputs Scope>1 ohne single_res (feste Breiten wie in der Erfassung) -->
							<Input placeholder="{i18n>placeholderTotal}" enabled="false" width="6rem"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01' &amp;&amp; !${SingleRes}}"/>
							<Input placeholder="{i18n>placeholderFailed}" enabled="false" width="6rem"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01' &amp;&amp; !${SingleRes}}">
								<layoutData>
									<FlexItemData styleClass="sapUiTinyMarginBegin"/>
								</layoutData>
							</Input>

							<!-- Quantitativ Einzelwert Scope=1 -->
							<Input placeholder="{i18n>placeholderResult}" enabled="false" width="6.5rem"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} === '01'}"/>

						</HBox>
					</HBox>
				</CustomListItem>
			</List>
		</Panel>
	</CustomListItem>
</core:FragmentDefinition>
