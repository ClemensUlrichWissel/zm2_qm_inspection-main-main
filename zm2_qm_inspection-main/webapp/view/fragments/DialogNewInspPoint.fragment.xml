<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="{i18n>dialogNewInspPointTitle}">
		<content>
			<form:SimpleForm layout="ResponsiveGridLayout" editable="true">
				<Label text="{i18n>selectOperationForNewInspPoint}" required="true"/>
				<Select items="{path: 'toOperationsWithInspPoints', filters: [{path: 'ControlKey', operator: 'EQ', value1: 'QM92'}]}" forceSelection="true">
					<items>
						<core:Item key="{InspLotAction}" text="{InspLotAction} {ActionText}"/>
					</items>
				</Select>
			</form:SimpleForm>
		</content>
		<buttons>
			<Button text="{i18n>cancel}" press="onPressDialogNewInspPointClose"/>
			<Button text="{i18n>createNewInspPointConfirm}" press="onPressDialogNewInspPointConfirm" type="Emphasized"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
