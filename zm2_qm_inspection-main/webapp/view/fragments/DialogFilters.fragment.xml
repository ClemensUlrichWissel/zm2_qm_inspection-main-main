<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Panel
        headerText="{i18n>filters}"
        expandable="true"
        expanded="true"
    >
        <f:SimpleForm editable="true">
            <f:content>
			<Label text="{i18n>plant}" />
                <MultiInput
                    submit="onSubmitFilter"
                    tokens="{FilterModel>/plant}"
                    showValueHelp="false"
                    tokenUpdate="onTokenUpdate"
                >
                    <tokens>
                        <Token text="{FilterModel>text}" />
                    </tokens>
                </MultiInput>

                <Label
                    text="{i18n>workplace}"
                />
                <MultiInput
                    submit="onSubmitFilter"
                    tokens="{FilterModel>/workplace}"
                    showValueHelp="false"
                    tokenUpdate="onTokenUpdate"
                >
                    <tokens>
                        <Token text="{FilterModel>text}" />
                    </tokens>
                </MultiInput>

                <Label text="{i18n>material}" />
                <MultiInput
                    submit="onSubmitFilter"
                    tokens="{FilterModel>/material}"
                    showValueHelp="false"
                    tokenUpdate="onTokenUpdate"
                >
                    <tokens>
                        <Token text="{FilterModel>text}" />
                    </tokens>
                </MultiInput>
            </f:content>
        </f:SimpleForm>
    </Panel>
</core:FragmentDefinition>
