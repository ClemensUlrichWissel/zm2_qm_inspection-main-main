<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Panel
        headerText="{i18n>filters}"
        expandable="true"
        expanded="true"
    >
        <f:SimpleForm editable="true">
            <f:content>
                <Label text="{i18n>plant}" />
                <HBox alignItems="Center" width="100%">
                    <MultiInput
                        submit="onSubmitFilter"
                        tokens="{FilterModel>/plant}"
                        showValueHelp="true"
                        valueHelpRequest="onValueHelpRequest"
                        showSuggestion="true"
                        suggestionItems="{Suggest>/plant}"
                        tokenUpdate="onTokenUpdate"
                    >
                        <tokens>
                            <Token text="{FilterModel>text}" />
                        </tokens>
                        <suggestionItems>
                            <core:Item text="{Suggest>value}" />
                        </suggestionItems>
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </MultiInput>
                    <Button
                        icon="{= ${FilterModel>/sort/Werks} === 'asc' ? 'sap-icon://sort-ascending' : ${FilterModel>/sort/Werks} === 'desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort'}"
                        press="onToggleSort"
                        tooltip="{i18n>sort}"
                        class="sapUiTinyMarginBegin">
                        <customData>
                            <core:CustomData key="sortField" value="Werks" />
                        </customData>
                    </Button>
                </HBox>

                <Label text="{i18n>workplace}" />
                <HBox alignItems="Center" width="100%">
                    <MultiInput
                        submit="onSubmitFilter"
                        tokens="{FilterModel>/workplace}"
                        showValueHelp="true"
                        valueHelpRequest="onValueHelpRequest"
                        showSuggestion="true"
                        suggestionItems="{Suggest>/workplace}"
                        tokenUpdate="onTokenUpdate"
                    >
                        <tokens>
                            <Token text="{FilterModel>text}" />
                        </tokens>
                        <suggestionItems>
                            <core:Item text="{Suggest>value}" />
                        </suggestionItems>
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </MultiInput>
                    <Button
                        icon="{= ${FilterModel>/sort/Workcenter} === 'asc' ? 'sap-icon://sort-ascending' : ${FilterModel>/sort/Workcenter} === 'desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort'}"
                        press="onToggleSort"
                        tooltip="{i18n>sort}"
                        class="sapUiTinyMarginBegin">
                        <customData>
                            <core:CustomData key="sortField" value="Workcenter" />
                        </customData>
                    </Button>
                </HBox>

                <Label text="{i18n>material}" />
                <HBox alignItems="Center" width="100%">
                    <MultiInput
                        submit="onSubmitFilter"
                        tokens="{FilterModel>/material}"
                        showValueHelp="true"
                        valueHelpRequest="onValueHelpRequest"
                        showSuggestion="true"
                        suggestionItems="{Suggest>/material}"
                        tokenUpdate="onTokenUpdate"
                    >
                        <tokens>
                            <Token text="{FilterModel>text}" />
                        </tokens>
                        <suggestionItems>
                            <core:ListItem text="{Suggest>value}" additionalText="{Suggest>text}" />
                        </suggestionItems>
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </MultiInput>
                    <Button
                        icon="{= ${FilterModel>/sort/Material} === 'asc' ? 'sap-icon://sort-ascending' : ${FilterModel>/sort/Material} === 'desc' ? 'sap-icon://sort-descending' : 'sap-icon://sort'}"
                        press="onToggleSort"
                        tooltip="{i18n>sort}"
                        class="sapUiTinyMarginBegin">
                        <customData>
                            <core:CustomData key="sortField" value="Material" />
                        </customData>
                    </Button>
                </HBox>
            </f:content>
        </f:SimpleForm>
    </Panel>
</core:FragmentDefinition>
