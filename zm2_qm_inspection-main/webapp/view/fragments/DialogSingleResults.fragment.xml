<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>enter-result}">
		<content>
			<!-- Quantitative Einzelwerterfassung -->
			<List items="{toResults}" visible="{= ${CharType} === '01'}">
				<CustomListItem>
					<HBox alignItems="Center" class="sapUiTinyMarginBeginEnd" justifyContent="SpaceBetween">
						<Label text="{ResultNumber}"/>
						<Input placeholder="{i18n>placeholderResult}"
							value="{ResValue}"
							valueState="{parts: [
								{path: 'ResValue'},
								{path: 'InspCharacteristic'},
								{path: 'InspectionLot'},
								{path: 'InspLotAction'},
								{path: 'InspSample'}
							], formatter: '.formatSingleResultValueState'}"/>
					</HBox>
				</CustomListItem>
			</List>

			<!-- Qualitative Einzelwerterfassung -->
			<List items="{toResults}" visible="{= ${CharType} !== '01'}">
				<CustomListItem>
					<HBox alignItems="Center" class="sapUiTinyMarginBeginEnd" justifyContent="SpaceBetween">
						<Label text="{ResultNumber}"/>
						<HBox alignItems="Center">
							<CheckBox selected="{= ${Code1} === ${i18n>XOK}}"
								text="{i18n>yes}"
								select="onSelectYesSingleResult"/>
							<CheckBox selected="{= !!${Code1} &amp;&amp; ${Code1} !== ${i18n>XOK}}"
								text="{i18n>no}"
								select="onSelectNoSingleResult"
								class="sapUiTinyMarginBegin"/>
						</HBox>
					</HBox>
				</CustomListItem>
			</List>
		</content>
		<buttons>
			<Button type="Emphasized" text="{i18n>close}" press="onCloseSingleResults"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
