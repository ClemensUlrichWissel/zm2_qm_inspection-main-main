<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>enter-result}">
		<content>
			<List items="{toResults}">
				<CustomListItem>
					<HBox alignItems="Center" class="sapUiTinyMarginBeginEnd" justifyContent="SpaceBetween">
						<Label text="{ResultNumber}" />
						<Input placeholder="{i18n>placeholderResult}"
							value="{ResValue}"
							valueState="{parts: [
								{path: 'ResValue'},
								{path: 'InspCharacteristic'},
								{path: 'InspectionLot'},
								{path: 'InspLotAction'},
								{path: 'InspSample'}
							], formatter: '.formatSingleResultValueState'}"/>
					</HBox>
				</CustomListItem>
			</List>
		</content>
		<buttons>
			<Button type="Emphasized" text="{i18n>close}" press="onCloseSingleResults" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>