<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<CustomListItem>
		<VBox class="sapUiSmallMargin">
			<HBox alignItems="Center">
				<Title level="H1"
					text="{parts: [
						{path: 'InspLotAction'},
						{path: 'ActionText'},
						{path: 'Workcenter'},
						{path: 'WorkcenterText'},
						{path: 'ControlKey'},
						{path: 'Usern1'},
						{path: 'PhysSmpl'},
						{path: 'Userd1'},
						{path: 'Usert1'}
					], formatter: '.formatOperationTitle'}">
					<layoutData>
						<FlexItemData minWidth="50%" growFactor="1"
							styleClass="sapUiSmallMarginBegin"/>
					</layoutData>
				</Title>
				<HBox width="10%" justifyContent="End" alignItems="Center">
					<layoutData>
						<FlexItemData minWidth="10%"
							styleClass="sapUiTinyMarginEnd"/>
					</layoutData>
					<Button type="Emphasized" icon="sap-icon://locked" press="onCloseOperation" tooltip="{i18n>close}"/>
				</HBox>
			</HBox>
			<List items="{path: 'toCharacteristics', templateShareable: false}">
				<CustomListItem class="sapUiTinyMargin"
					type="Inactive"
					highlight="{Highlight}">
					<HBox alignItems="Center">
						<Text text="{parts: [
							{path: 'InspCharacteristic'},
							{path: 'MasterCharact'},
							{path: 'CharactText'},
							{path: 'TargetVal'},
							{path: 'UpTolLmt'},
							{path: 'LwTolLmt'},
							{path: 'CharType'},
							{path: 'UnitText'},
							{path: 'Scope'}
						], formatter: '.formatCharacteristicTitle'}">
							<layoutData>
								<FlexItemData maxWidth="50%" minWidth="50%"
									styleClass="sapUiSmallMarginBegin"/>
							</layoutData>
						</Text>
						<HBox width="50%" justifyContent="End" alignItems="Center">
							<CheckBox selected="{= ${Code1} === ${i18n>XOK}}" visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								enabled="{= !${Skipped} &amp;&amp; !${Closed}}" text="{i18n>yes}" select="onSelectYes"/>
							<CheckBox selected="{= ${Code1} === ${i18n>XNOK}}" visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								enabled="{= !${Skipped} &amp;&amp; !${Closed}}" text="{i18n>no}" select="onSelectNo"/>

							<Input placeholder="{i18n>placeholderTotal}"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01'}"
								value="{ValidVals}" editable="{= !${Skipped} &amp;&amp; !${Closed}}"/>
							<Input placeholder="{i18n>placeholderFailed}"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01'}"
								value="{Nonconf}" editable="{= !${Skipped} &amp;&amp; !${Closed}}">
								<layoutData>
									<FlexItemData styleClass="sapUiTinyMarginBegin"/>
								</layoutData>
							</Input>

							<Input placeholder="{i18n>placeholderResult}"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} === '01'}"
								value="{ResValue}" editable="{= !${Skipped} &amp;&amp; !${Closed}}"/>

							<Text text="{i18n>mean-value}: {MeanValue} |"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} === '01' &amp;&amp; ${MeanValue} !== ''}"
								class="sapUiTinyMarginEnd" />
							<Text text="{i18n>variance}: {Variance} |"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} === '01' &amp;&amp; ${Variance} !== ''}"
								class="sapUiTinyMarginEnd" />
							<Button text="{i18n>buttonRecordSampleResults}"
								press="onPressSampleResults"
								type="{= ${Highlight} === 'Error' ? 'Reject' : ${Highlight} === 'Success' ? 'Accept' : 'Default'}"
								icon="sap-icon://clinical-tast-tracker"
								enabled="{= !${Skipped} &amp;&amp; !${Closed}}"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} === '01'}"/>

							<Button icon="sap-icon://document-text" press="onPressComment"
								class="sapUiSmallMarginBegin" enabled="{= !${Skipped} &amp;&amp; !${Closed}}"/>

							<Button icon="sap-icon://hint" press="onPressCharacteristic"
								class="sapUiTinyMarginBegin" tooltip="{i18n>longtext}"/>

							<Text text="|" class="sapUiTinyMarginBeginEnd"/>

							<Button type="Accept" icon="sap-icon://accept" press="onCloseAccept" tooltip="{i18n>accept}"
								enabled="{= !${Skipped} &amp;&amp; !${Closed}}" />
							<Button type="Reject" icon="sap-icon://decline" press="onCloseReject" tooltip="{i18n>reject}"
								enabled="{= !${Skipped} &amp;&amp; !${Closed}}" />
						</HBox>
					</HBox>
				</CustomListItem>
			</List>
		</VBox>
	</CustomListItem>
</core:FragmentDefinition>
