<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<CustomListItem>
		<Panel expandable="true" expanded="{= ${ControlKey} === 'QM92'}" class="sapUiSmallMargin">
			<headerToolbar>
				<Toolbar>
					<Title level="H1"
						text="{parts: [
							{path: 'InspLotAction'},
							{path: 'ActionText'},
							{path: 'Workcenter'},
							{path: 'WorkcenterText'},
							{path: 'ControlKey'},
							{path: 'Usern1'},
							{path: 'PhysSmpl'},
							{path: 'Userd1'},
							{path: 'Usert1'}
						], formatter: '.formatOperationTitle'}"/>
					<ToolbarSpacer/>
					<!-- Rechter Abstand wie bei den Merkmalszeilen, damit der Abschließen-Button
					     bündig über den Annehmen/Ablehnen-Buttons steht -->
					<Button type="Emphasized" icon="sap-icon://locked" press="onCloseOperation" tooltip="{i18n>close}"
						class="sapUiSmallMarginEnd"
						enabled="{= ${ControlKey} === 'QM92'}"/>
				</Toolbar>
			</headerToolbar>
			<List items="{path: 'toCharacteristics', templateShareable: false}"
				updateFinished="onCharacteristicsUpdateFinished">
				<CustomListItem class="sapUiTinyMargin"
					type="Inactive"
					highlight="{Highlight}">
					<!-- Feste Zwei-Spalten-Zeile: links der Text, rechts die Bedienelemente.
					     Kein wrap - die Spalten bleiben immer nebeneinander -->
					<HBox alignItems="Start">
						<!-- Textspalte: wächst mit, kann aber schrumpfen (minWidth 0) -> der
						     (Lang-)Text wird darin abgeschnitten, statt die Spalte aufzublähen -->
						<VBox>
							<layoutData>
								<FlexItemData growFactor="3" shrinkFactor="1" minWidth="0"
									styleClass="sapUiSmallMarginBegin"/>
							</layoutData>
							<Text width="100%" text="{parts: [
								{path: 'InspCharacteristic'},
								{path: 'MasterCharact'},
								{path: 'CharactText'},
								{path: 'TargetVal'},
								{path: 'UpTolLmt'},
								{path: 'LwTolLmt'},
								{path: 'CharType'},
								{path: 'UnitText'},
								{path: 'Scope'}
							], formatter: '.formatCharacteristicTitle'}"/>
							<!-- Langtext eingeklappt auf 1 Zeile; "Mehr anzeigen" blendet der
							     Controller nur ein, wenn der Text wirklich abgeschnitten ist -->
							<Text width="100%" maxLines="1"
								text="{path: 'CharactLongtext', formatter: '.formatLongtext'}"
								visible="{= !!${CharactLongtext} }"/>
							<Link text="{i18n>showMore}" press="onToggleLongtext" visible="false"/>
						</VBox>
						<!-- Bedienelemente: shrinkFactor 0 -> nie zusammengedrückt; minWidth sorgt
						     dafür, dass sie erst auf sehr schmalen Bildschirmen umbrechen -->
						<HBox justifyContent="End" alignItems="Center" wrap="Wrap">
							<layoutData>
								<FlexItemData growFactor="1" shrinkFactor="0" minWidth="14rem"/>
							</layoutData>
							<CheckBox selected="{= !!${Code1} &amp;&amp; ${Code1} === (${OkCode} || ${i18n>XOK})}"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"
								text="{i18n>yes}" select="onSelectYes"/>
							<CheckBox selected="{= !!${Code1} &amp;&amp; ${Code1} !== (${OkCode} || ${i18n>XOK})}"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} !== '01'}"
								enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"
								text="{i18n>no}" select="onSelectNo"/>

							<!-- Aggregat-Inputs nur für qualitative Scope>1 OHNE single_res (also sample_res/char_res).
							     Feste Breiten, damit die Eingabezeilen nicht breiter werden als die übrigen Zeilen -->
							<Input placeholder="{i18n>placeholderTotal}" width="6rem"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01' &amp;&amp; !${SingleRes}}"
								value="{ValidVals}"
								editable="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"/>
							<Input placeholder="{i18n>placeholderFailed}" width="6rem"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} !== '01' &amp;&amp; !${SingleRes}}"
								value="{Nonconf}"
								editable="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}">
								<layoutData>
									<FlexItemData styleClass="sapUiTinyMarginBegin"/>
								</layoutData>
							</Input>

							<Input placeholder="{i18n>placeholderResult}" width="6.5rem"
								visible="{= ${Scope} === '0000001' &amp;&amp; ${CharType} === '01'}"
								value="{ResValue}"
								valueState="{parts: [{path: 'ResValue'},{path: 'LwTolLmt'},{path: 'UpTolLmt'}], formatter: '.formatValueState'}"
								valueStateText="{i18n>valueStateOutOfTolerance}"
								editable="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"/>

							<Text text="{i18n>mean-value}: {MeanValue} |"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} === '01' &amp;&amp; ${MeanValue} !== ''}"
								class="sapUiTinyMarginEnd" />
							<Text text="{i18n>variance}: {Variance} |"
								visible="{= ${Scope} > '0000001' &amp;&amp; ${CharType} === '01' &amp;&amp; ${Variance} !== ''}"
								class="sapUiTinyMarginEnd" />
							<!-- Ergebnis-Dialog für: quantitativ Scope>1 ODER qualitativ Scope>1 mit single_res -->
							<Button text="{i18n>buttonRecordSampleResults}"
								press="onPressSampleResults"
								type="{= ${Highlight} === 'Error' ? 'Reject' : ${Highlight} === 'Success' ? 'Accept' : 'Default'}"
								icon="sap-icon://clinical-tast-tracker"
								enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"
								visible="{= ${Scope} > '0000001' &amp;&amp; ( ${CharType} === '01' || ${SingleRes} )}"/>

							<Button icon="sap-icon://document-text" press="onPressComment"
								class="sapUiSmallMarginBegin"
								enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"/>

							<HBox alignItems="Center" justifyContent="End" width="6.5rem">
								<Text text="|" class="sapUiTinyMarginBeginEnd"
									visible="{= ${CharType} !== '01'}"/>

								<Button type="Accept" icon="sap-icon://accept" press="onCloseAccept" tooltip="{i18n>accept}"
									visible="{= ${CharType} !== '01'}"
									enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"/>
								<Button type="Reject" icon="sap-icon://decline" press="onCloseReject" tooltip="{i18n>reject}"
									visible="{= ${CharType} !== '01'}"
									enabled="{parts: [{path: 'Skipped'},{path: 'Closed'},{path: 'InspLotAction'},{path: 'InspectionLot'},{path: 'InspSample'}], formatter: '.isCharEditable'}"/>
							</HBox>
						</HBox>
					</HBox>
				</CustomListItem>
			</List>
		</Panel>
	</CustomListItem>
</core:FragmentDefinition>
