<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="{i18n>dialogNewSampleTitle}">
		<content>
			<form:SimpleForm layout="ResponsiveGridLayout" editable="true">
				<Label text="{i18n>selectOperationForNewSample}"/>
				<Select items="{toOperationsWithInspPoints}" forceSelection="true">
					<items>
						<core:Item key="{InspLotAction}" text="{InspLotAction} {ActionText}"/>
					</items>
				</Select>
			</form:SimpleForm>
		</content>
		<buttons>
			<Button text="{i18n>cancel}" press="onPressDialogNewSampleClose"/>
			<Button text="{i18n>createNewSampleConfirm}" press="onPressDialogNewSampleConfirm"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>