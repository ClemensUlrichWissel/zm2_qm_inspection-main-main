{
    "_version": "1.12.0",
    "sap.app": {
        "id": "de.mindsquare.InspectionQM",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "sourceTemplate": {
            "id": "servicecatalog.connectivityComponentForManifest",
            "version": "0.0.0",
            "toolsId": "2e3044c6-19e5-4a45-b94d-47f80fc6e0ec"
        },
        "dataSources": {
            "ZM2_QM_INSPECTION_SRV": {
                "uri": "/sap/opu/odata/sap/ZM2_QM_INSPECTION_SRV/",
                "type": "OData",
                "settings": {
                    "localUri": "localService/metadata.xml"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "config": {
            "fullWidth": true
        },
        "flexEnabled": false,
        "rootView": {
            "viewName": "de.mindsquare.InspectionQM.view.App",
            "type": "XML",
            "async": true,
            "id": "App"
        },
        "dependencies": {
            "minUI5Version": "1.65.6",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "de.mindsquare.InspectionQM.i18n.i18n"
                }
            },
            "": {
                "type": "sap.ui.model.odata.v2.ODataModel",
                "settings": {
                    "defaultOperationMode": "Server",
                    "defaultBindingMode": "TwoWay",
                    "defaultCountMode": "Request"
                },
                "dataSource": "ZM2_QM_INSPECTION_SRV",
                "preload": true
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "async": true,
                "viewPath": "de.mindsquare.InspectionQM.view",
                "controlId": "splitApp",
                "clearControlAggregation": false
            },
            "routes": [
                {
                    "name": "RouteMain",
                    "pattern": "",
                    "target": [
                        "TargetMaster",
                        "TargetEmpty"
                    ]
                },
                {
                    "name": "InspectionLotDetail",
                    "pattern": "InspectionLot/{LotNumber}",
                    "target": [
                        "TargetMaster",
                        "TargetDetail"
                    ]
                }
            ],
            "targets": {
                "TargetMaster": {
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false,
                    "controlAggregation": "masterPages",
                    "viewId": "Master",
                    "viewName": "Master"
                },
                "TargetEmpty": {
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false,
                    "controlAggregation": "detailPages",
                    "viewId": "Empty",
                    "viewName": "Empty"
                },
                "TargetDetail": {
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false,
                    "controlAggregation": "detailPages",
                    "viewId": "Detail",
                    "viewName": "Detail"
                }
            }
        }
    }
}